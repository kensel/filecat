# Copy to .env (gitignored). tests/conftest.py loads it; variables already
# set in the environment win. Each FILECAT_TEST_* variable turns on the
# tests for one server; leave it out and those tests skip.
# The values match the containers in compose.yaml.

FILECAT_TEST_POSTGRES=postgresql://filecat:filecat@127.0.0.1:5432/filecat
FILECAT_TEST_MYSQL=mysql://filecat:filecat@127.0.0.1:3306/filecat
FILECAT_TEST_MSSQL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=127.0.0.1,1433;DATABASE=master;UID=sa;PWD=Filecat-Test-1;TrustServerCertificate=yes
FILECAT_TEST_MONGODB=mongodb://127.0.0.1:27017/filecat_test

# A writable SMB share: a UNC path on Windows (\\localhost\Data), or the
# mount point of a CIFS mount elsewhere (/mnt/filecat-smb).
# FILECAT_TEST_SMB=\\localhost\Data

# A real PE file for the optional Rich-header check in test_probe_pe.py.
# FILECAT_EXE=C:\Windows\System32\notepad.exe
