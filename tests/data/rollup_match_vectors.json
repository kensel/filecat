 "normalize": [
  {
   "pattern": "node_modules",
   "form": "name",
   "text": "node_modules",
   "dir_only": false
  },
  {
   "pattern": "node_modules/",
   "form": "name",
   "text": "node_modules",
   "dir_only": true
  },
  {
   "pattern": "/volume1//homes/jdoe/",
   "form": "agent",
   "text": "/volume1/homes/jdoe",
   "dir_only": true
  },
  {
   "pattern": "\\\\nas3\\homes\\jdoe\\vault",
   "form": "share",
   "text": "//nas3/homes/jdoe/vault",
   "dir_only": false
  },
  {
