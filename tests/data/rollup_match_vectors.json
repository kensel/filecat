{
 "version": 1,
 "about": "Conformance vectors for the rollup matcher, the wire policy id and the sticky-redaction HMAC (docs/rollups.md sections 2 and 3.7). `match`: first matching rule's tag for a path (null: recorded normally); entries with agent=true are what the filecat-agent must pass (patterns already normalised, path in the agent's own form); the others are the Python matcher's share and local forms. `normalize`: Python only. `policy`: the id configure_policy answers. `redaction`: HMAC-SHA256(key, 'filecat-redact-v1\\0' + root + '\\0' + rel_path), hex of the first 16 bytes.",
 "match": [
  {
   "name": "name pattern, directory",
   "rules": [
    {
     "tag": "[CACHE]",
     "match": [
      "node_modules"
     ],
     "type": "dir",
     "case": "sensitive"
    }
   ],
   "path": "/volume1/a/node_modules",
   "is_dir": true,
   "expect": "[CACHE]",
   "agent": true
  },
  {
   "name": "name pattern, type dir skips a file",
   "rules": [
    {
     "tag": "[CACHE]",
     "match": [
      "node_modules"
     ],
     "type": "dir",
     "case": "sensitive"
    }
   ],
   "path": "/volume1/a/node_modules",
   "is_dir": false,
   "expect": null,
   "agent": true
  },
  {
   "name": "name pattern is case sensitive by default",
   "rules": [
    {
     "tag": "[CACHE]",
     "match": [
      "node_modules"
     ],
     "type": "dir",
     "case": "sensitive"
    }
   ],
   "path": "/volume1/a/Node_Modules",
   "is_dir": true,
   "expect": null,
   "agent": true
  },
  {
   "name": "name pattern, case insensitive",
   "rules": [
    {
     "tag": "[CACHE]",
     "match": [
      "node_modules"
     ],
     "type": "dir",
     "case": "insensitive"
    }
   ],
   "path": "/volume1/a/Node_Modules",
   "is_dir": true,
   "expect": "[CACHE]",
   "agent": true
  },
  {
   "name": "name pattern matches at any depth",
   "rules": [
    {
     "tag": "[CACHE]",
     "match": [
      "node_modules"
     ],
     "type": "dir",
     "case": "sensitive"
    }
   ],
   "path": "/a/b/c/d/node_modules",
   "is_dir": true,
   "expect": "[CACHE]",
   "agent": true
  },
  {
   "name": "name pattern matches the whole name",
   "rules": [
    {
     "tag": "[CACHE]",
     "match": [
      "node_modules"
     ],
     "type": "dir",
     "case": "sensitive"
    }
   ],
   "path": "/a/node_modules2",
   "is_dir": true,
   "expect": null,
   "agent": true
  },
  {
   "name": "agent form, exact",
   "rules": [
    {
     "tag": "[REDACTED]",
     "match": [
      "/volume1/homes/jdoe/vault"
     ],
     "type": "any",
     "case": "sensitive",
     "private": true
    }
   ],
   "path": "/volume1/homes/jdoe/vault",
   "is_dir": true,
   "expect": "[REDACTED]",
   "agent": true
  },
  {
   "name": "agent form is anchored at the end",
   "rules": [
    {
     "tag": "[REDACTED]",
     "match": [
      "/volume1/homes/jdoe/vault"
     ],
     "type": "any",
     "case": "sensitive",
