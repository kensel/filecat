   "form": "share",
   "text": "//nas3/homes/jdoe/vault",
   "dir_only": false
  },
  {
   "pattern": "C:\\Users\\x\\AppData",
   "form": "local",
   "text": "C:/Users/x/AppData",
   "dir_only": false
  },
  {
   "pattern": "**/AppData/Local/Temp",
   "form": "suffix",
   "text": "**/AppData/Local/Temp",
   "dir_only": false
  },
  {
   "pattern": "**\\AppData\\Local\\Temp",
   "form": "suffix",
   "text": "**/AppData/Local/Temp",
   "dir_only": false
  }
 ],
 "policy": [
  {
   "rules": [
    {
