   "expect": null,
   "agent": true
  },
  {
   "name": "agent form is anchored at the start",
   "rules": [
    {
     "tag": "[REDACTED]",
     "match": [
      "/volume1/homes/jdoe/vault"
     ],
     "type": "any",
     "case": "sensitive",
     "private": true
    }
   ],
   "path": "/mnt/volume1/homes/jdoe/vault",
   "is_dir": true,
   "expect": null,
   "agent": true
  },
