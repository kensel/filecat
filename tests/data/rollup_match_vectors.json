    },
    {
     "tag": "[SYNOLOGY]",
     "match": [
      "@eaDir"
     ],
     "type": "dir",
     "case": "sensitive",
     "suggest": true
    }
   ],
   "markers": [
    ".filecat-redacted",
    ".filecat-cache"
   ],
   "id": "efc2ddfe66c9"
  },
